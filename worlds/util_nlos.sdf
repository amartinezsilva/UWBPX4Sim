<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9" xmlns:uwb="https://github.com/amartinezsilva/UWBPX4Sim">
  <world name="util_nlos">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Thin wall: same thickness as walls.sdf (1 m) -->

    <!-- UTIL flight dataset, constellation 4, trial 4: one metal and three
         wooden cabinets, each 0.5 m in front of a ground-level anchor on its
         line to the centre of the flown path (UTIL doesn't survey them, so the
         placement is reconstructed). Used by config/demo_util_nlos.yaml; see
         docs/measurement_model.md, Calibration. -->

    <!-- metal cabinet blocking UTIL anchor 2 -->
    <model name="metal_cabinet_2">
      <static>true</static>
      <pose>3.144 3.187 0.56 0 0 -2.3183</pose>
      <uwb:material>metal</uwb:material>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.49 0.92 1.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.49 0.92 1.12</size></box></geometry>
          <material><ambient>0.55 0.57 0.6 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wood cabinet blocking UTIL anchor 0 -->
    <model name="wood_cabinet_0">
      <static>true</static>
      <pose>-2.58 -3.513 0.445 0 0 0.904</pose>
      <uwb:material>wood</uwb:material>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.39 0.44 0.89</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.39 0.44 0.89</size></box></geometry>
          <material><ambient>0.6 0.42 0.25 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wood cabinet blocking UTIL anchor 5 -->
    <model name="wood_cabinet_5">
      <static>true</static>
      <pose>3.457 -3.277 0.445 0 0 2.3683</pose>
      <uwb:material>wood</uwb:material>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.39 0.44 0.89</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.39 0.44 0.89</size></box></geometry>
          <material><ambient>0.6 0.42 0.25 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- wood cabinet blocking UTIL anchor 7 -->
    <model name="wood_cabinet_7">
      <static>true</static>
      <pose>-2.719 2.813 0.445 0 0 -0.7843</pose>
      <uwb:material>wood</uwb:material>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.39 0.44 0.89</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.39 0.44 0.89</size></box></geometry>
          <material><ambient>0.6 0.42 0.25 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
